generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SizeSystem {
  EUR
  US
  CM
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PREPARATION
  DISPATCH
  TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LoyaltyEntryType {
  RECYCLING_BONUS
  REDEMPTION
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(254)
  name               String              @db.VarChar(120)
  documentType       String?             @db.VarChar(20)
  documentNumber     String?             @db.VarChar(32)
  phone              String?             @db.VarChar(20)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  passwordCredential PasswordCredential?
  refreshSessions    RefreshSession[]
  auditEvents        AuditEvent[]
  addresses          Address[]
  favorites          Favorite[]
  cart               Cart?
  orders             Order[]
  supportTickets     SupportTicket[]
  loyaltyEntries     LoyaltyEntry[]
  giftCards          GiftCard[]
}

model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String   @db.VarChar(255)
  passwordUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  eventType String   @db.VarChar(64)
  ipAddress String?  @db.VarChar(45)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  brandId     String           @db.Uuid
  categoryId  String           @db.Uuid
  name        String           @db.VarChar(160)
  slug        String           @unique @db.VarChar(180)
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]
  favorites   Favorite[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @db.Uuid
  sku          String      @unique @db.VarChar(64)
  sizeSystem   SizeSystem
  sizeValue    String      @db.VarChar(16)
  color        String      @db.VarChar(40)
  price        Decimal     @db.Decimal(10, 2)
  comparePrice Decimal?    @db.Decimal(10, 2)
  stock        Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([productId, sizeSystem, sizeValue, color])
  @@index([productId, isActive])
  @@index([sizeSystem, sizeValue])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(2048)
  altText   String?  @db.VarChar(160)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
}

model Favorite {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String   @db.VarChar(60)
  recipient  String   @db.VarChar(120)
  line1      String   @db.VarChar(180)
  district   String   @db.VarChar(80)
  province   String   @db.VarChar(80)
  department String   @db.VarChar(80)
  postalCode String?  @db.VarChar(20)
  country    String   @default("PE") @db.Char(2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId, isDefault])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id              String                @id @default(uuid()) @db.Uuid
  publicNumber    String                @unique @db.VarChar(32)
  userId          String                @db.Uuid
  addressId       String?               @db.Uuid
  status          OrderStatus           @default(PREPARATION)
  paymentMethod   PaymentMethod
  subtotal        Decimal               @db.Decimal(10, 2)
  shipping        Decimal               @db.Decimal(10, 2)
  total           Decimal               @db.Decimal(10, 2)
  currency        String                @default("PEN") @db.Char(3)
  carrier         String?               @db.VarChar(100)
  trackingCode    String?               @db.VarChar(100)
  estimatedFrom   DateTime?
  estimatedTo     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  address         Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressSnapshot OrderAddressSnapshot?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  paymentAttempts PaymentAttempt[]
  supportTickets  SupportTicket[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderAddressSnapshot {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @unique @db.Uuid
  recipient  String  @db.VarChar(120)
  line1      String  @db.VarChar(180)
  district   String  @db.VarChar(80)
  province   String  @db.VarChar(80)
  department String  @db.VarChar(80)
  postalCode String? @db.VarChar(20)
  country    String  @db.Char(2)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @db.Uuid
  variantId   String?         @db.Uuid
  productName String          @db.VarChar(160)
  sku         String          @db.VarChar(64)
  sizeSystem  SizeSystem
  sizeValue   String          @db.VarChar(16)
  color       String          @db.VarChar(40)
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  subtotal    Decimal         @db.Decimal(10, 2)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?     @db.VarChar(255)
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  providerRef String?       @unique @db.VarChar(120)
  failureCode String?       @db.VarChar(80)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status])
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  orderId   String?             @db.Uuid
  subject   String              @db.VarChar(160)
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([orderId])
}

/// Puntos que no provienen de compras (los de compras se calculan desde Order).
/// points > 0 suma puntos; points < 0 los canjea por saldo en walletAmount.
model LoyaltyEntry {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         LoyaltyEntryType
  points       Int
  walletAmount Decimal          @default(0) @db.Decimal(10, 2)
  description  String           @db.VarChar(160)
  reference    String?          @unique @db.VarChar(32)
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
}

model GiftCard {
  id             String   @id @default(uuid()) @db.Uuid
  purchaserId    String   @db.Uuid
  code           String   @unique @db.VarChar(24)
  amount         Decimal  @db.Decimal(10, 2)
  recipientName  String   @db.VarChar(120)
  recipientEmail String   @db.VarChar(254)
  message        String?  @db.VarChar(120)
  createdAt      DateTime @default(now())
  purchaser      User     @relation(fields: [purchaserId], references: [id], onDelete: Cascade)

  @@index([purchaserId, createdAt])
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(120)
  district  String   @db.VarChar(80)
  address   String   @db.VarChar(180)
  hours     String   @db.VarChar(80)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(180)
  title       String   @db.VarChar(180)
  category    String   @db.VarChar(40)
  summary     String   @db.VarChar(255)
  body        String
  imageUrl    String   @db.VarChar(2048)
  readMinutes Int
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}
