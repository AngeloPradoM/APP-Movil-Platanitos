# Local development defaults. Never commit real secrets.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# DATABASE_URL se configurará localmente cuando definamos las credenciales de PostgreSQL.
# Ejemplo local (reemplaza USUARIO_LOCAL y CONTRASENA_LOCAL; no lo compartas ni lo subas):
# DATABASE_URL=postgresql://USUARIO_LOCAL:CONTRASENA_LOCAL@127.0.0.1:5432/platanitos
# JWT_ACCESS_SECRET=crea_un_secreto_aleatorio_de_al_menos_32_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
