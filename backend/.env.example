# =====================================================================
# Plantilla de configuración del backend de Platanitos.
# 1. Copia este archivo como "backend/.env"  (PowerShell: Copy-Item .env.example .env)
# 2. Reemplaza los valores marcados con CAMBIAR.
# 3. Nunca subas backend/.env a GitHub (ya está en .gitignore).
# La explicación de cada variable está en el README, paso 5.
# =====================================================================

# --- Servidor -------------------------------------------------------
# Puerto donde escucha la API (la app Flutter espera 3000 por defecto).
PORT=3000
# 127.0.0.1 = solo esta PC (navegador y emulador Android).
# 0.0.0.0   = también otros equipos de tu red (celular físico por Wi-Fi).
HOST=127.0.0.1
# development en tu PC; production solo al desplegar en un servidor.
NODE_ENV=development

# --- CORS (qué páginas web pueden llamar a la API) ------------------
# Orígenes permitidos separados por comas, sin espacios ni "/" final.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# true acepta cualquier puerto de localhost (Flutter Web cambia de puerto en cada ejecución).
CORS_ALLOW_LOCALHOST=true

# --- Base de datos PostgreSQL ---------------------------------------
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BASE
# CAMBIAR: USUARIO y CONTRASENA por los de tu instalación de PostgreSQL.
# Si la contraseña tiene caracteres especiales (@ : / # ? %), codifícalos (ver README).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@127.0.0.1:5432/platanitos

# --- Autenticación (JWT) --------------------------------------------
# CAMBIAR: secreto aleatorio de al menos 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Duración del token de acceso (15m = 15 minutos).
JWT_ACCESS_TTL=15m
# Días que dura la sesión antes de volver a iniciar sesión.
JWT_REFRESH_TTL_DAYS=30
